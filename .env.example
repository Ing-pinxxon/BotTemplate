# Puerto en el que corre el servidor localmente
PORT=3000

# API Key de Google Gemini (Obtenida de Google AI Studio)
GEMINI_API_KEY=tu_api_key_de_gemini

# Modelo de Gemini a utilizar (Por defecto gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash

# API Key de Kapso (si utilizas Kapso)
KAPSO_API_KEY=tu_api_key_de_kapso

# ID del número de WhatsApp en Kapso o Meta Cloud API
DEFAULT_PHONE_NUMBER_ID=tu_phone_number_id

# Token de verificación para configurar el Webhook
META_VERIFY_TOKEN=tu_token_de_verificacion

# Token de acceso de Meta (Solo si envías mensajes directo sin Kapso)
META_ACCESS_TOKEN=tu_access_token_de_meta

# Número del administrador para alertas de leads (con indicativo de país, sin '+')
ADMIN_NUMBER=573000000000

# Número del equipo de cocina o despachos (opcional)
KITCHEN_NUMBER=573000000000

# Número para notificaciones de pago Bold/Zapier (opcional)
BOLD_NOTIFY_NUMBER=573000000000
